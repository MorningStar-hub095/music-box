# Music Box - Development Environment Defaults
# This file is committed to Git for development defaults
# Override locally in server/.env

API_PORT=49200
WEB_PORT=49201
ADMIN_PORT=49202
BROWSE_PORT=49203

AUTO_RESTART=false
STARTUP_TIMEOUT=30000
HEALTH_CHECK_INTERVAL=30000
MAX_RESTART_ATTEMPTS=3

LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
