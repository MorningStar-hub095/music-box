# ============================================================
# Docker 部署环境变量示例
# 用法：cp .env.docker.example .env，然后修改下面两项再 docker compose up -d
# （本文件可安全提交到 Git；真正的 .env 已被 .gitignore 排除）
# ============================================================

# PostgreSQL 数据库密码（必填，建议 24+ 位随机串）
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# JWT 签名密钥（必填，至少 32 字符随机串，泄露 = 任何人可伪造登录态）
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ---- 以下为可选覆盖（有合理默认值）----
# POSTGRES_DB=music_box
# ALLOWED_ORIGINS=https://your-domain.com

# 演示模式：true 时关闭第三方音频播放/缓存（公网 Demo 版权合规），仅播放 local-music 内的自有版权音频
# DEMO_MODE=true
