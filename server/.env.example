# ===========================================
# Music Box API Server 环境变量配置
# ===========================================
# 复制此文件为 .env 并根据环境修改配置
# cp .env.example .env

# -------------------------------------------
# 基础配置
# -------------------------------------------
# 运行环境: development | test | production
NODE_ENV=development

# 服务器端口
PORT=8088

# -------------------------------------------
# 数据库配置
# -------------------------------------------
# MySQL 连接字符串
# 格式: mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL="mysql://root:password@localhost:3306/music_box"

# -------------------------------------------
# Redis 配置
# -------------------------------------------
# Redis 连接字符串
# 格式: redis://[:密码]@主机:端口
REDIS_URL="redis://localhost:6379"

# -------------------------------------------
# JWT 认证配置
# -------------------------------------------
# JWT 密钥 (生产环境必须使用强随机密钥，至少32字符)
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-at-least-32-chars-long"

# JWT 过期时间
JWT_EXPIRES_IN="7d"

# -------------------------------------------
# CORS 跨域配置
# -------------------------------------------
# 允许的前端域名 (逗号分隔)
# 示例: http://localhost:5173,https://your-domain.com
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8088"

# -------------------------------------------
# 速率限制配置
# -------------------------------------------
# 全局速率限制
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# 认证接口速率限制 (更严格)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# 搜索接口速率限制
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX=60

# -------------------------------------------
# 缓存配置
# -------------------------------------------
# 默认缓存过期时间 (秒)
CACHE_DEFAULT_TTL=300

# 搜索结果缓存时间 (秒)
CACHE_SEARCH_TTL=60

# 热门搜索缓存时间 (秒)
CACHE_HOT_SEARCH_TTL=300

# -------------------------------------------
# 日志配置
# -------------------------------------------
# 日志级别: error | warn | info | debug
LOG_LEVEL=info

# 是否记录请求日志
ENABLE_REQUEST_LOGGING=true

# -------------------------------------------
# 安全配置
# -------------------------------------------
# 请求体大小限制
REQUEST_BODY_LIMIT="10kb"

# 是否信任代理 (生产环境通常为 true)
TRUST_PROXY=false

# -------------------------------------------
# 搜索配置
# -------------------------------------------
# 搜索结果每页数量限制
SEARCH_MAX_LIMIT=100

# 搜索关键词最大长度
SEARCH_MAX_QUERY_LENGTH=100

# -------------------------------------------
# 文件上传配置 (如需要)
# -------------------------------------------
# UPLOAD_DIR="./uploads"
# MAX_FILE_SIZE="10mb"

# -------------------------------------------
# LLM 配置（AI 电台 / AI 推荐）
# -------------------------------------------
# 提供商类型: ollama | openai | deepseek | qwen | glm | kimi | custom
#   ollama  = 本地 Ollama（无需 API Key，本地推理）
#   openai  = 官方 OpenAI
#   deepseek= DeepSeek（OpenAI 兼容，中文强、价格低）
#   qwen    = 阿里云通义千问（OpenAI 兼容）
#   glm     = 智谱 GLM（OpenAI 兼容）
#   kimi    = Moonshot Kimi（OpenAI 兼容）
#   custom  = 自定义任意 OpenAI 兼容端点（需同时配置 LLM_BASE_URL）
LLM_PROVIDER=ollama

# OpenAI 官方配置（LLM_PROVIDER=openai 时生效）
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# Ollama 本地配置（LLM_PROVIDER=ollama 时生效）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI 兼容提供商通用配置（LLM_PROVIDER=deepseek/qwen/glm/kimi/custom 时生效）
# LLM_API_KEY 为统一密钥；LLM_MODEL/LLM_BASE_URL 可覆盖预设默认值
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# 通用温度参数（可选，默认 0.7）
LLM_TEMPERATURE=0.7
